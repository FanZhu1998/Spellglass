<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for the hardened runtime of a Mac app signed with a Developer ID
     (electron-builder.config.mjs, mac). The app and its helpers share them. allow-jit: V8 compiles
     JavaScript. camera: the wand tracker; macOS asks the player with the Info.plist sentence. There is
     no microphone: the desktop app has no voice. entitlements.mac.adhoc.plist is this plus what ad hoc
     signing needs; keep the two alike. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
  </dict>
</plist>
